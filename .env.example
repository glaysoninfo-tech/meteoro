APP_NAME=Meteoro API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://meteoro:meteoro@localhost:5432/meteoro
AUTH_MODE=local
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
KEYCLOAK_ISSUER_URL=
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWT_ALGORITHM=RS256
INGESTION_HTTP_TIMEOUT_SECONDS=30
INGESTION_HTTP_RETRY_ATTEMPTS=3
INGESTION_HTTP_RETRY_BACKOFF_SECONDS=0.5
INGESTION_HTTP_MAX_RESPONSE_BYTES=26214400
# Lista fechada, separada por vírgulas. Aceita host exato ou subdomínios (*.dominio.gov.br).
# Nunca use "*". Sem hosts configurados, conectores de rede são bloqueados.
INGESTION_NETWORK_ALLOWED_HOSTS=api.exemplo.gov.br,*.dados.gov.br,api.open-meteo.com,archive-api.open-meteo.com,api-redemet.decea.mil.br
# Inclua 80 somente se HTTP sem TLS for uma exceção formalmente aprovada.
INGESTION_NETWORK_ALLOWED_PORTS=443,1883,4840
INGESTION_HTTP_ALLOWED_SCHEMES=https
# Buckets S3 também são uma allowlist fechada.
INGESTION_S3_ALLOWED_BUCKETS=meteoro-dados-oficiais
INGESTION_MQTT_CAPTURE_TIMEOUT_SECONDS=30
INGESTION_OPCUA_TIMEOUT_SECONDS=15
INGESTION_STORAGE_PATH=../data/raw
INGESTION_MAX_UPLOAD_BYTES=26214400
INGESTION_UPLOAD_CHUNK_BYTES=1048576
INGESTION_SCHEDULER_ENABLED=false
INGESTION_SCHEDULER_POLL_SECONDS=60
REDIS_URL=redis://localhost:6379/0
INGESTION_WORKER_QUEUE_NAME=meteoro:ingestion:jobs
INGESTION_WORKER_POLL_SECONDS=5
INGESTION_WORKER_LOCK_TTL_SECONDS=300
# Organização exposta no portal público; mantenha vazio para desabilitar a superfície pública.
PUBLIC_ORGANIZATION_ID=
# Chave da REDEMET/DECEA. Nunca a coloque no frontend, em arquivos versionados
# ou no campo endpoint_reference do Catálogo de fontes.
REDEMET_API_KEY=
