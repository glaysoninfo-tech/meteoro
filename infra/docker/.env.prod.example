# Copie para .env.prod (MESMA pasta) e preencha. O .env.prod NUNCA é versionado.
# Gere segredos fortes: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Aplicação ---
ENVIRONMENT=production
APP_NAME=Meteoro API
JWT_SECRET_KEY=TROQUE_POR_SEGREDO_FORTE_DE_48_CARACTERES_OU_MAIS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
AUTH_MODE=local

# --- Banco (host "postgres" = serviço do compose) ---
POSTGRES_DB=meteoro
POSTGRES_USER=meteoro
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
DATABASE_URL=postgresql+psycopg://meteoro:TROQUE_POR_SENHA_FORTE@postgres:5432/meteoro

# --- Redis (host "redis" = serviço do compose) ---
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_REDIS
REDIS_URL=redis://:TROQUE_POR_SENHA_FORTE_REDIS@redis:6379/0
READINESS_REQUIRE_REDIS=true

# --- MinIO ---
MINIO_ROOT_USER=meteoro-admin
MINIO_ROOT_PASSWORD=TROQUE_POR_SENHA_FORTE_MINIO

# --- Ingestão ---
INGESTION_STORAGE_PATH=/data/raw
INGESTION_SCHEDULER_ENABLED=true
INGESTION_NETWORK_ALLOWED_HOSTS=api.open-meteo.com,archive-api.open-meteo.com,api-redemet.decea.mil.br
INGESTION_NETWORK_ALLOWED_PORTS=443
INGESTION_HTTP_ALLOWED_SCHEMES=https
REDEMET_API_KEY=COLOQUE_A_CHAVE_REDEMET_AQUI

# --- Portal público ---
# Preencha com o organization_id real após o primeiro bootstrap.
PUBLIC_ORGANIZATION_ID=

# --- Rate limit público ---
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CSV_RATE_LIMIT_PER_MINUTE=10
